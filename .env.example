# Wezblue Enterprise Jira Environment Configuration Example

# Cloud PostgreSQL Connection String (Supabase / Neon.tech / Vercel Postgres / Railway)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# If omitted, the platform runs in local persistent disk mode (data/wezblue_db.json)
DATABASE_URL= postgresql://postgres:password@localhost:5432/wezblue_jira?sslmode=require

# Next.js Port (optional, defaults to 3000)
PORT=3000
