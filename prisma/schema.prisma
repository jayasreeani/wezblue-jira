datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  PRODUCT_OWNER
  DEVELOPER
  QA_ENGINEER
  VIEWER
}

enum ProjectTemplate {
  SCRUM
  KANBAN
}

enum SprintStatus {
  FUTURE
  ACTIVE
  COMPLETED
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
}

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  UNDER_REVIEW
  IN_QA
  IN_STAKEHOLDER_VALIDATION
  DONE
}

enum Priority {
  HIGHEST
  HIGH
  MEDIUM
  LOW
  LOWEST
}

enum BugSeverity {
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  name         String
  avatar       String?
  role         Role            @default(DEVELOPER)
  department   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  assignedIssues Issue[]       @relation("AssigneeRelation")
  reportedIssues Issue[]       @relation("ReporterRelation")
  comments       Comment[]
  activityLogs   ActivityLog[]
  projectMembers ProjectMember[]
  notifications  Notification[]
  attachments    Attachment[]
  workLogs       WorkLog[]
  leadProjects   Project[]     @relation("ProjectLead")
  confluenceDocs ConfluenceDoc[]
}

model Project {
  id          String          @id @default(uuid())
  key         String          @unique
  name        String
  description String?
  template    ProjectTemplate @default(SCRUM)
  leadId      String?
  lead        User?           @relation("ProjectLead", fields: [leadId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members     ProjectMember[]
  sprints     Sprint[]
  epics       Epic[]
  issues      Issue[]
  activityLogs ActivityLog[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @default(DEVELOPER)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Sprint {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  goal        String?
  startDate   DateTime?
  endDate     DateTime?
  status      SprintStatus @default(FUTURE)
  velocity    Int?         @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  issues      Issue[]
}

model Epic {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  summary     String?
  color       String   @default("#8777d9")
  status      String   @default("IN_PROGRESS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issues      Issue[]
}

model Issue {
  id           String       @id @default(uuid())
  key          String       @unique
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         IssueType    @default(STORY)
  summary      String
  description  String?
  status       IssueStatus  @default(TODO)
  priority     Priority     @default(MEDIUM)
  severity     BugSeverity?
  actualPoints   Int?
  estimatedHours Float?
  actualHours    Float?       @default(0)
  remainingHours Float?
  order          Int          @default(0)
  
  assigneeId     String?
  assignee       User?        @relation("AssigneeRelation", fields: [assigneeId], references: [id])
  reporterId     String?
  reporter       User?        @relation("ReporterRelation", fields: [reporterId], references: [id])
  
  sprintId       String?
  sprint         Sprint?      @relation(fields: [sprintId], references: [id])
  epicId         String?
  epic           Epic?        @relation(fields: [epicId], references: [id])
  
  parentStoryId  String?
  parentStory    Issue?       @relation("StoryChildren", fields: [parentStoryId], references: [id])
  childIssues    Issue[]      @relation("StoryChildren")

  parentId       String?
  parent         Issue?       @relation("SubTasks", fields: [parentId], references: [id])
  subtasks       Issue[]      @relation("SubTasks")
  
  dueDate                DateTime?
  plannedCompletionDate  DateTime?
  actualCompletionDate   DateTime?
  environment            String?
  reproduceSteps         String?
  figmaUrl               String?      @map("figma_url")
  feature                String?      @map("feature")
  acceptanceCriteria     String?      @map("acceptance_criteria")
  phase                  String?      @default("MVP") @map("phase")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  comments     Comment[]
  attachments  Attachment[]
  activityLogs ActivityLog[]
  workLogs     WorkLog[]
}

model WorkLog {
  id        String   @id @default(uuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  hours     Float
  comment   String?
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id          String   @id @default(uuid())
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  filename    String
  fileUrl     String
  fileSize    Int
  fileType    String
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id])
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueId      String?
  issue        Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  action       String
  fieldChanged String?
  oldValue     String?
  newValue     String?
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum DocStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum DocCategory {
  PRD
  ARCHITECTURE
  RUNBOOK
  RETROSPECTIVE
  DECISION_RECORD
  MEETING_NOTES
  GENERAL
}

model ConfluenceSpace {
  id          String          @id @default(uuid())
  key         String          @unique
  name        String
  description String?
  icon        String?         @default("BookOpen")
  color       String?         @default("#0052cc")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  docs        ConfluenceDoc[]
}

model ConfluenceDoc {
  id              String          @id @default(uuid())
  spaceId         String
  space           ConfluenceSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  title           String
  content         String
  category        DocCategory     @default(GENERAL)
  status          DocStatus       @default(DRAFT)
  authorId        String?
  author          User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  linkedIssueKeys String[]
  excerpt         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}
